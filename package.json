{
  "author": "Martin Nabhan",
  "description": "An Apollo Server integration for use with Next.js",
  "devDependencies": {
    "@apollo/server": "5.5.1",
    "@apollo/server-integration-testsuite": "5.5.1",
    "@babel/core": "7.29.7",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "3.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "babel-plugin-tsconfig-paths-module-resolver": "1.0.4",
    "jest": "29.7.0",
    "next": "16.3.1",
    "next12": "npm:next@12.3.7",
    "next13": "npm:next@13.5.11",
    "next14": "npm:next@14.2.35",
    "next15": "npm:next@15.5.23",
    "next16": "npm:next@16.3.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2",
    "wireit": "0.14.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/**/*"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@as-integrations/next",
  "peerDependencies": {
    "@apollo/server": "^5.0.0",
    "next": "^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apollo-server-integrations/apollo-server-integration-next.git"
  },
  "scripts": {
    "build": "wireit",
    "check": "wireit",
    "check:changeset": "bash -c 'AUTHOR=$(git show -s --format=\"%ae\" HEAD); if [[ $AUTHOR != *\"renovate\"* ]] && [[ $AUTHOR != *\"github-actions\"* ]]; then changeset status --since=origin/main; fi'",
    "check:oxfmt": "wireit",
    "check:oxlint": "wireit",
    "check:tsc": "wireit",
    "fix": "wireit",
    "fix:oxfmt": "wireit",
    "fix:oxlint": "wireit",
    "prepack": "npm run build",
    "publish:changeset": "changeset publish",
    "test": "wireit",
    "test:next": "DEBUG_PRINT_LIMIT=2147483647 __NEXT_TEST_MODE=jest jest",
    "test:next12": "NEXT_VERSION=12 npm run test:next",
    "test:next13": "NEXT_VERSION=13 npm run test:next",
    "test:next14": "NEXT_VERSION=14 npm run test:next",
    "test:next15": "NEXT_VERSION=15 npm run test:next",
    "test:next16": "NEXT_VERSION=16 npm run test:next"
  },
  "types": "dist/index.d.ts",
  "version": "4.1.0",
  "wireit": {
    "build": {
      "command": "tsc -p tsconfig.build.json",
      "dependencies": [
        "check:oxfmt",
        "check:oxlint"
      ],
      "output": [
        "./dist/**/*"
      ]
    },
    "check": {
      "dependencies": [
        "check:changeset",
        "check:oxfmt",
        "check:oxlint",
        "check:tsc"
      ]
    },
    "check:oxfmt": {
      "command": "oxfmt --check"
    },
    "check:oxlint": {
      "command": "oxlint"
    },
    "check:tsc": {
      "command": "tsc --noEmit"
    },
    "fix": {
      "dependencies": [
        "fix:oxfmt",
        "fix:oxlint"
      ]
    },
    "fix:oxfmt": {
      "command": "oxfmt"
    },
    "fix:oxlint": {
      "command": "oxlint --fix"
    },
    "test": {
      "dependencies": [
        "test:next12",
        "test:next13",
        "test:next14",
        "test:next15",
        "test:next16"
      ]
    }
  }
}
